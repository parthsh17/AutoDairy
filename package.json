    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.3.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.3.6",
    "vite-plugin-pwa": "^1.3.0",
